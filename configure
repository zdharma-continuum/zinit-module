#!/bin/sh
# Build the zinit module against the zsh release of your zsh.
# The script downloads that release from zsh.org and runs its configure script.

set -e

usage() {
  cat << 'EOF'
Usage: ./configure [OPTION]... [ZSH-CONFIGURE-OPTION]...

Download the zsh release of your zsh and prepare the module build.

Options:
  --with-zsh=PATH            match this zsh binary (default: zsh on PATH)
  --with-zsh-version=X.Y.Z   use this zsh version instead of asking a zsh binary
  --with-zsh-source=FILE     use this zsh release tarball instead of a download
  -h, --help                 show this help

The script passes all other options to the configure script of zsh.
Environment variables such as CC, CFLAGS, CPPFLAGS and LDFLAGS also pass through.
EOF
}

say() { printf 'configure: %s\n' "$*"; }
warn() { printf 'configure: warning: %s\n' "$*" >&2; }
die() {
  printf 'configure: error: %s\n' "$*" >&2
  exit 1
}

srcdir=$(cd "$(dirname "$0")" && pwd)
builddir=.build
moddir=Src/zdharma_continuum
zsh_bin=zsh
zsh_version=
zsh_source=
release=

# Keep the options for zsh in "$@" and remove the options of this script.
for arg; do
  shift
  case $arg in
    --with-zsh=*) zsh_bin=${arg#*=} ;;
    --with-zsh-version=*) zsh_version=${arg#*=} ;;
    --with-zsh-source=*) zsh_source=${arg#*=} ;;
    -h | --help)
      usage
      exit 0
      ;;
    # An old config.status runs "configure --recheck" with these options. That old build is gone.
    --no-create | --no-recursion) exit 0 ;;
    *) set -- "$@" "$arg" ;;
  esac
done

cd "$srcdir"

# fetch URL FILE: download URL to FILE with curl or wget.
fetch() {
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$2" "$1"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    die "curl or wget is necessary to download zsh"
  fi
}

# download VERSION: put zsh-VERSION.tar.xz into the download cache.
download() {
  tarball=$builddir/zsh-$1.tar.xz
  [ -s "$tarball" ] && return 0
  for dir in pub pub/old; do
    url=https://www.zsh.org/$dir/zsh-$1.tar.xz
    if fetch "$url" "$tarball.part" 2> /dev/null; then
      mv "$tarball.part" "$tarball"
      say "downloaded $url"
      return 0
    fi
  done
  rm -f "$tarball.part"
  return 1
}

# list_releases: print the version of each zsh release on zsh.org, one per line.
list_releases() {
  for dir in pub pub/old; do
    fetch "https://www.zsh.org/$dir/" /dev/stdout 2> /dev/null || true
  done | grep -o 'href="zsh-[0-9][0-9.]*\.tar\.xz"' | sed 's/^href="zsh-//; s/\.tar\.xz"$//' | sort -u
}

# pick_release VERSION: from stdin, print the newest release up to VERSION.
pick_release() {
  awk -v want="$1" '
    function key(v,    n, a, i, k) {
      n = split(v, a, ".")
      k = ""
      for (i = 1; i <= 5; i++) k = k sprintf("%06d", (i <= n) ? a[i] : 0)
      return k
    }
    { k = key($0); if (k <= key(want) && k > best) { best = k; ver = $0 } }
    END { if (ver != "") print ver }'
}

mkdir -p "$builddir"

if [ -n "$zsh_source" ]; then
  [ -f "$zsh_source" ] || die "no such file: $zsh_source"
  tarball=$zsh_source
  tree=$(tar -tf "$tarball" | sed -n '1s,/.*,,p')
  [ -n "$tree" ] || die "cannot read $tarball"
  say "using zsh sources from $tarball"
else
  if [ -z "$zsh_version" ]; then
    command -v "$zsh_bin" > /dev/null 2>&1 || die "cannot find zsh ($zsh_bin). Use --with-zsh=PATH."
    # shellcheck disable=SC2016 # zsh expands $ZSH_VERSION, not this shell.
    zsh_version=$("$zsh_bin" -fc 'print -r -- $ZSH_VERSION') || die "cannot run $zsh_bin"
    say "zsh $zsh_version at $(command -v "$zsh_bin")"
  fi
  base=$(printf '%s\n' "$zsh_version" | sed 's/^\([0-9][0-9.]*[0-9]\).*/\1/')
  case $base in
    [0-9]*.[0-9]*) ;;
    *) die "cannot read a version number from '$zsh_version'" ;;
  esac

  # A release version without a suffix has its own tarball on zsh.org.
  release=
  if [ "$base" = "$zsh_version" ] && download "$zsh_version"; then
    release=$zsh_version
  else
    release=$(list_releases | pick_release "$base")
    [ -n "$release" ] || die "zsh.org has no release up to $base. Use --with-zsh-source=FILE."
    warn "zsh $zsh_version has no release tarball. The module builds against zsh $release."
    download "$release" || die "cannot download zsh $release"
  fi
  tarball=$builddir/zsh-$release.tar.xz
  tree=zsh-$release
fi

# Extract a clean tree for each configure run.
rm -rf "${builddir:?}/$tree"
tar -xf "$tarball" -C "$builddir" || die "cannot extract $tarball (tar needs xz support)"
[ -f "$builddir/$tree/Src/zsh.mdd" ] || die "$tarball does not contain zsh sources"
mkdir -p "$builddir/$tree/$moddir"
cp -p "$moddir/zinit.c" "$moddir/zinit.mdd" "$builddir/$tree/$moddir/"

# Old zsh configure tests fail under clang 16 and gcc 14. These flags turn the errors back into warnings.
cc=${CC:-cc}
extra_cflags=
probe=$builddir/probe.c
printf 'int main(void) { return 0; }\n' > "$probe"
for flag in -Wno-error=implicit-int -Wno-error=implicit-function-declaration; do
  if "$cc" "$flag" -c -o "$builddir/probe.o" "$probe" > /dev/null 2>&1; then
    extra_cflags="$extra_cflags $flag"
  fi
done
rm -f "$probe" "$builddir/probe.o"

say "running the zsh configure script in $builddir/$tree"
log=$builddir/configure.log
if ! (cd "$builddir/$tree" && CFLAGS="${CFLAGS:--O2}$extra_cflags" ./configure --disable-gdbm --without-tcsetpgrp "$@") > "$log" 2>&1; then
  tail -n 20 "$log" >&2
  die "the zsh configure script failed. See $log."
fi

grep -q '^name=zdharma_continuum/zinit .* link=dynamic' "$builddir/$tree/config.modules" \
  || die "zsh cannot load modules with this compiler. See $log."
dl_ext=$(sed -n "s/^DL_EXT[[:space:]]*=[[:space:]]*//p" "$builddir/$tree/Config/defs.mk")
[ -n "$dl_ext" ] || dl_ext=so

bundle=
case $(uname -s) in
  Darwin) bundle=yes ;;
esac

cat > Makefile << EOF
# Makefile for the zinit module. ./configure writes this file.

TREE = $builddir/$tree
MODDIR = $moddir
DL_EXT = $dl_ext

all: \$(MODDIR)/zinit.so

\$(MODDIR)/zinit.so: \$(MODDIR)/zinit.c \$(MODDIR)/zinit.mdd Makefile
	cp -p \$(MODDIR)/zinit.c \$(MODDIR)/zinit.mdd \$(TREE)/\$(MODDIR)/
	cd \$(TREE) && \$(MAKE) prep
	cd \$(TREE)/Src && \$(MAKE) headers zsh.export
	cd \$(TREE)/\$(MODDIR) && \$(MAKE) zinit.\$(DL_EXT)
	cp -p \$(TREE)/\$(MODDIR)/zinit.\$(DL_EXT) \$(MODDIR)/zinit.so
EOF
if [ -n "$bundle" ]; then
  # shellcheck disable=SC2016 # make expands $(MODDIR), not this shell.
  printf '\t%s\n' 'cp -p $(MODDIR)/zinit.so $(MODDIR)/zinit.bundle' >> Makefile
fi
cat >> Makefile << 'EOF'

clean:
	rm -f $(MODDIR)/zinit.so $(MODDIR)/zinit.bundle
	if test -f $(TREE)/$(MODDIR)/Makefile; then cd $(TREE)/$(MODDIR) && $(MAKE) clean; fi

distclean: clean
	rm -rf .build Makefile

.PHONY: all clean distclean
EOF

if [ -n "$release" ]; then built_from="zsh $release"; else built_from=$tree; fi
say "the module builds against $built_from. Run make."
